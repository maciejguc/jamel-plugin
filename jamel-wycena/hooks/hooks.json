{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PLUGIN_ROOT}/scripts/.venv\" ] || { python3 -m venv \"${CLAUDE_PLUGIN_ROOT}/scripts/.venv\" && \"${CLAUDE_PLUGIN_ROOT}/scripts/.venv/bin/pip\" install -q -r \"${CLAUDE_PLUGIN_ROOT}/scripts/requirements.txt\"; } 1>&2; exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); printf '%s' \"$p\" | grep -qiE 'wycen|wyce\\xc5\\x84|kosztorys' && echo 'Przypomnienie: do stworzenia wyceny uzyj skilla generate-wycena (lub komendy /wycena).'; exit 0"
          }
        ]
      }
    ]
  }
}
